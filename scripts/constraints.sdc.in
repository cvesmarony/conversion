# Template: the Makefile substitutes the @...@ values.
# Units are the liberty library's units (ns / pF or fF -- check your .lib).
create_clock -name clk -period @CLK_PERIOD@ [get_ports clk]
set_clock_uncertainty @UNCERT@ [get_clocks clk]

set data_in [remove_from_collection [all_inputs] [get_ports clk]]
set_input_delay  @IO_DELAY@ -clock clk $data_in
set_output_delay @IO_DELAY@ -clock clk [all_outputs]

# Optional: uncomment and adapt to your library
# set_driving_cell -lib_cell BUF_X2 $data_in
# set_load 0.01 [all_outputs]
